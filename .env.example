# --- JetSmart / Caravelo (obligatorio) ---
# DevTools > Network > hacé una búsqueda en el portal > click en "availability/..."
# El UUID al final de esa URL:
AYCF_PASS_ID=
# El header "cookie" de ese request. Solo se usa como SEMILLA: a partir de ahí el
# radar renueva laravel_session solo en cada respuesta. Es una credencial.
AYCF_COOKIE=

# --- Telegram (opcional, pero es la salida principal) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Webhook genérico (opcional): Discord, Slack, ntfy, lo que uses ---
WEBHOOK_URL=

# --- Estado (sesión + dedupe) ---
# En Vercel hace falta Redis: el filesystem es efímero y la sesión se perdería.
# Sirve Upstash o Vercel KV (también lee KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Self-hosteando alcanza un archivo (default: .state.json)
STATE_FILE=

# --- Watches ---
# En Vercel, el JSON entero acá. Self-hosteando, usá watches.json.
WATCHES=

# --- Producción ---
# Inventalo largo. Vercel lo manda como Bearer; sin esto el endpoint queda público.
CRON_SECRET=
