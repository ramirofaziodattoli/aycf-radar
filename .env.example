# Copiá este archivo a .env y completalo. El .env NO se commitea (está en .gitignore).

# --- Telegram ---
# Token del BotFather. Si se te escapó alguna vez, rotalo con /revoke.
TELEGRAM_TOKEN=
# Tu chat con el bot. Mandale /start por privado y sacalo con:
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | grep -o '"id":[-0-9]*'
TELEGRAM_CHAT_ID=

# --- JetSmart / Caravelo ---
# DevTools > Network > hacé una búsqueda > click en el request "availability/..."
# El UUID que va al final de esa URL:
AYCF_PASS_ID=
# El header "cookie" completo de ese mismo request. Es una credencial: no la compartas.
AYCF_COOKIE=

# --- Solo para producción en Vercel ---
# Inventá una cadena larga. Sin esto el endpoint queda público.
# En local no hace falta.
CRON_SECRET=
